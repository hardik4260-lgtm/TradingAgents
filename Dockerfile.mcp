FROM python:3.12-slim
WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir ".[mcp]" \
    && useradd --create-home --uid 10001 engine \
    && mkdir -p /home/engine/.tradingagents \
    && chown -R engine:engine /home/engine/.tradingagents
USER engine
ENV TRADINGAGENTS_MCP_HOST=0.0.0.0
EXPOSE 8000
CMD ["tradingagents-mcp", "--transport", "streamable-http"]
